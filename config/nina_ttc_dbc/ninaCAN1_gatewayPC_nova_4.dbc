CM_ BU_ TTC "TTC580";
CM_ BU_ GatewayPC "Linux";
CM_ SG_ 71 uint16PotiThrottleCmd "Raw signal sent to the throttle-poti input of the curtis motor";
CM_ SG_ 70 uint8VehicleSpeed "Raw vehicle speed value as measured by the encoder";
CM_ SG_ 69 int16SteeringVelocityCmd "Raw velocity signal output sent to the steering motor";
CM_ SG_ 68 int16SteeringVelocity "Raw feedback value of the steering motor velocity";
CM_ SG_ 3 VehicleVelocityRequested "requested vehicle velocity";
CM_ SG_ 3 SteeringPositionRequested "Scaled requested steering position";
CM_ SG_ 3 VehicleVelocityMeasured "measured vehicle velocity";
CM_ SG_ 3 SteeringPositionMeasured "Scaled steering position as measured by the encoders";
CM_ SG_ 48 ABS_RearRight "Frequency of the rear right wheel encoder reading";
CM_ SG_ 48 ABS_RearLeft "Frequency of the rear left wheel encoder reading";
CM_ SG_ 48 ABS_FrontRight "Frequency of the front right wheel encoder reading";
CM_ SG_ 48 ABS_FrontLeft "Frequency of the front left wheel encoder reading";
CM_ SG_ 72 ThrottleSignal "Scaled throttle signal received from the handlebar sensor";
CM_ SG_ 72 SteeringMotorSpeedCmd "Scaled speed command value sent to the steering motor";
CM_ SG_ 72 CurtisSpeedCmd "Scaled speed command sent to the curtis motor";
CM_ SG_ 72 SteeringTorqueSignal "Scaled steering torque signal as measured by the force-sensors";
CM_ SG_ 72 SteeringVelocitySignal "Scaled steering velocity signal as received from the steering motor";
CM_ SG_ 72 BrakeSignal "Scaled braking signal from handlebar";
CM_ SG_ 67 uint16EncoderRawValueB "Raw signal of the steering position encoder B";
CM_ SG_ 67 uint16EncoderRawValueA "Raw signal of the steering position encoder A";
CM_ SG_ 66 uint32SignalSteeringForceB "Raw signal of the steering force sensor B";
CM_ SG_ 66 uint32SignalSteeringForceA "Raw signal of the steering force sensor A";
CM_ SG_ 65 uint32SignalBrakeB "Raw signal of the brake sensor B";
CM_ SG_ 65 uint32SignalBrakeA "Raw signal of the brake sensor A";
CM_ SG_ 64 uint32SignalThrottleB "Raw throttle signals received from the handlebar sensor B";
CM_ SG_ 64 uint32SignalThrottleA "Raw throttle signals received from the handlebar sensor A";
CM_ SG_ 16 RemoteStatusLightBlinkRateReq "Request blink rate of status lights  (the value is multiplied with 250ms: 0=static, 1=4Hz, 2=2Hz, etc.)";
CM_ SG_ 16 RemoteStatusLightColorReq "Request color of status lights (0=off, 1=green, 2=yellow, 3=red)";
CM_ SG_ 16 RemoteHornReq "Request to turn accoustic horn on";
CM_ SG_ 16 RemoteLightBrakeReq "Request to turn brake lights on";
CM_ SG_ 16 RemoteBlinkLeftReq "Request to turn 'blink left' light on";
CM_ SG_ 16 RemoteBlinkRightReq "Request to turn 'blink right' light on";
CM_ SG_ 16 RemoteBrightsOnReq "Request to turn brights on";
CM_ SG_ 16 RemoteLightReverseReq "Request to turn reverse lights on";
CM_ SG_ 16 RemoteLightsTurnLeftReq "Request to turn 'turn left' lights on";
CM_ SG_ 16 RemoteLightsTurnRightReq "Request to turn 'turn right' lights on";
CM_ SG_ 17 RemoteBrakeReq "Request vehicle to brake";
CM_ SG_ 17 RemoteSteeringMotorVelocityReq "Requested steering motor velocity";
CM_ SG_ 17 RemoteSteeringAngleReq "Requested steering angle (0=center, +100=full right, -100=full left)";
CM_ SG_ 17 RemoteVelocityReq "Requested driving velocity (positive values result in drive forward)";
CM_ SG_ 2 RequestSteeringMotorInhibit "TTC internal software signal reflecting whether the steering motor is inhibited due to an internal reason";
CM_ SG_ 2 CollisionAvoidance_Stop "Stop request due to the collision avoidance function";
CM_ SG_ 2 CollisionAvoidance_Slowdown "Slowdown request due to the collision avoidance function";
CM_ SG_ 2 Signal12Switch "State of the '1-2'-switch";
CM_ SG_ 2 RequestZeroThrottle "TTC internal software signal reflecting whether the throttle is set to zero due to an internal reasion";
CM_ SG_ 2 RequestBrake "TTC internal software signal reflecting whether braking is requested due to an internal reason";
CM_ SG_ 2 SignalBrightsOn "State of the 'brights on'-switch";
CM_ SG_ 2 SignalRightTurn "TBD";
CM_ SG_ 2 SignalLeftTurn "TBD";
CM_ SG_ 2 SignalHorn "State of the 'horn on'-button";
CM_ SG_ 2 SignalHazardLights "State of the 'hazard lights on'-switch";
CM_ SG_ 2 SignalDirectionReverse "State of the 'direction reverse'-switch";
CM_ SG_ 2 SignalBrakeSwitch "State of the brake-switch integrated into the handlebar";
CM_ SG_ 2 SignalSeatSwitch "State of the 'seat empty'-switch";
CM_ SG_ 2 EStopStatus "State of the emergency button(s)";
CM_ SG_ 2 SelectedApplication "Currently selected 'Application'";
CM_ SG_ 2 SelectedOpMode "Currently selected 'OpMode'";
CM_ SG_ 2 ActiveOpMode "Currently active 'OpMode'";
CM_ SG_ 2 ButtonBlue "State of the blue button in the cockpit";
CM_ SG_ 2 ButtonYellow "State of the yellow button in the cockpit";
CM_ SG_ 2 ButtonGreen "State of the green button in the cockpit";

